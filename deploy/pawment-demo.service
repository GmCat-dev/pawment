# Optional: the live demo host (one pretend-money sandbox per visitor). Needs no secrets and contacts no outside services.
[Unit]
Description=Pawment live demo
After=network.target

[Service]
ExecStart=/usr/bin/node /opt/pawment/demo/host.mjs
Environment=DEMO_PORT=4202
Environment=DEMO_URL=https://demo.example.com
User=www-data
Group=www-data
Restart=on-failure
MemoryMax=600M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
